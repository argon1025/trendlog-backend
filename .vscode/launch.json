{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "java",
			"name": "Trendlog API",
			"request": "launch",
			"mainClass": "io.trendlog.api.ApiApplication",
			"projectName": "api",
			"args": "--spring.profiles.active=${input:springProfile}",
			"envFile": "${workspaceFolder}/.env"
		}
	],
	"inputs": [
		{
			"id": "springProfile",
			"type": "pickString",
			"description": "실행할 환경을 고르세요",
			"options": [
				"dev",
				"prod"
			],
			"default": "dev"
		}
	]
}
